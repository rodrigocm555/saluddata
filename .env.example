# FRONTEND (Vite - React)
# Solo se necesita si ejecutas React en modo desarrollo con Vite
# VITE_API_URL=http://127.0.0.1:8000/api

# BACKEND (FastAPI - Python)
# Configuración de base de datos (Railway PostgreSQL o Supabase)
DATABASE_URL=postgresql://user:password@host:port/database

# Configuración de seguridad
APP_SECRET=[generar-con-openssl-rand-hex-32]
TOKEN_HOURS=8

# Configuración de CORS (separar por comas múltiples orígenes)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tu-frontend.vercel.app,https://tu-frontend.railway.app

# Configuración de email (opcional)
EMAIL_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Configuración de usuario administrador
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@saluddata.local
ADMIN_PASSWORD=Cambiar123!
